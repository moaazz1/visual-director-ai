# Backend only. Copy to .env and pass --env-file .env to uvicorn.
VISION_API_KEY=
VISION_MODEL=gpt-4.1-mini
VISION_BASE_URL=https://api.openai.com/v1
# Optional production storage. Leave unset for SQLite and local storage.
# DATABASE_URL=postgresql+psycopg://director:password@127.0.0.1:5432/director
# S3_BUCKET=visual-director-private
# S3_ENDPOINT_URL=https://your-s3-compatible-endpoint
# AWS_DEFAULT_REGION=us-east-1
# DATA_DIR=.data
# COOKIE_SECURE=1
# For Gemini, set VISION_PROVIDER=gemini, leave VISION_MODEL unset for its default,
# and configure GEMINI_API_KEY instead of VISION_API_KEY.
